  <!-- ============================================ -->
  <!-- SENSOR MOUNTS -->
  <!-- ============================================ -->
  
  <!-- Depth Camera (Intel RealSense) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="trunk"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.034" radius="0.045"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="trunk"/>
    <child link="lidar_link"/>
    <origin xyz="0.18 0 0.07" rpy="0 0 0"/>
  </joint>

